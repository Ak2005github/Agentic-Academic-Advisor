# Local LLM generation (Groq takes priority when both providers are configured).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional reranking; downloads model weights on first use.
ENABLE_RERANKER=true

# Optional dense retrieval: requires OpenAI embeddings and a populated index.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=langchain-ned-data
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Optional inherited backend services.
DATABASE_HOST=
DATABASE_USER=
DATABASE_PW=
DATABASE=
SECRET_KEY=
